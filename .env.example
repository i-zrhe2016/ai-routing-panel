# Optional docker compose overrides for local deployment.
PANEL_PUBLIC_URL=http://your-node-or-domain:18080
# Public subscription hostname; falls back to PANEL_PUBLIC_URL when empty.
PANEL_SUBSCRIPTION_PUBLIC_URL=https://sub.xray.zrhe2016.cc
PANEL_USERNAME=
PANEL_PASSWORD=
PANEL_SECRET_KEY=
# Structured application logs. Fluent Bit forwards stdout/stderr to Loki.
PANEL_LOG_LEVEL=INFO
PANEL_SLOW_REQUEST_MS=1000
AI_ROUTING_ENABLED=1
DATAPLANE_SSH_TARGET=
DATAPLANE_SSH_OPTIONS=
DATAPLANE_REMOTE_COMMAND_TIMEOUT=8
DATAPLANE_API_SERVER=127.0.0.1:10085
DATAPLANE_CONFIG_PATH=
DATAPLANE_DYNAMIC_ROUTING_PATH=
DATAPLANE_AI_REPORT_PATH=
DATAPLANE_PANEL_DB_PATH=
DATAPLANE_PANEL_PORTS_PATH=
DATAPLANE_ACCESS_LOG_PATH=
DATAPLANE_RESTART_COMMAND=
DATAPLANE_PROBE_HOST=127.0.0.1
# AI 节点纳管：远端独立 Xray，SSH 纳管，复用数据面 REALITY 参数，freedom 直出。
AI_NODE_SSH_TARGET=
AI_NODE_SSH_OPTIONS=
AI_NODE_CONTAINER_NAME=xray-ai-node
AI_NODE_RESTART_COMMAND=
AI_NODE_CONFIG_PATH=/etc/xray/config.json
AI_NODE_PROBE_HOST=
DNS_FAILOVER_ENABLED=0
DNS_FAILOVER_INTERVAL=15
DNS_FAILOVER_TIMEOUT=3
DNS_FAILOVER_FAILURE_THRESHOLD=3
DNS_FAILOVER_RECOVERY_THRESHOLD=2
DNS_FAILOVER_PROBE_HOST=
DNS_FAILOVER_PROBE_PORT=
CF_API_TOKEN=
CF_ZONE_ID=
CF_DNS_RECORD_ID=
CF_DNS_RECORD_TYPE=A
CF_DNS_RECORD_NAME=
CF_DNS_RECORD_PROXIED=0
CF_DNS_RECORD_TTL=60
# 留空时自动获取数据面公网 IP
DNS_FAILOVER_PRIMARY_CONTENT=
# 启用后，备用留空时自动使用控制面本机公网 IP，并配合备用 Xray 服务接管
CONTROL_PLANE_BACKUP_XRAY_ENABLED=0
# 留空时自动获取控制面本机公网 IP
DNS_FAILOVER_BACKUP_CONTENT=
DNS_FAILOVER_BACKUP_LABEL=控制面备用Xray
# 可选：在高峰窗口内优先切到备用/专用节点；窗口外恢复主节点优先。
DNS_FAILOVER_PEAK_ENABLED=0
DNS_FAILOVER_PEAK_START=19:00
DNS_FAILOVER_PEAK_END=23:00
# 可使用 IANA 时区名或 UTC 偏移，例如 America/Los_Angeles / +08:00
DNS_FAILOVER_PEAK_TIMEZONE=
DB_BACKUP_R2_ENABLED=0
DB_BACKUP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
DB_BACKUP_R2_BUCKET=xray-routing-panel-disaster
DB_BACKUP_R2_ACCESS_KEY_ID=
DB_BACKUP_R2_SECRET_ACCESS_KEY=
DB_BACKUP_R2_REGION=auto
DB_BACKUP_R2_PREFIX=xray-routing-panel
# R2 upload record is stored beside local backups.
DB_BACKUP_R2_RECORD_PATH=/backups/r2-upload-record.json
# Daily encrypted disaster bundle. Paths are comma/newline separated and are
# stored under config/ in the archive; missing optional paths are skipped.
DB_BACKUP_BUNDLE_ENABLED=1
DB_BACKUP_BUNDLE_DIR=/backups
DB_BACKUP_BUNDLE_KEEP_DAYS=7
DB_BACKUP_BUNDLE_PREFIX=xray-routing-panel
# Optional secondary SQLite database; Compose mounts /srv/xray-ops read-only.
DB_BACKUP_OPS_DB_PATH=/ops-data/ops.db
# Daily disaster bundle. Keep this password separate from R2 credentials.
DB_BACKUP_ENCRYPTION_PASSWORD=
# Explicit allowlist. The resulting tar is mode 0600 and is encrypted with
# AES-256-GCM before upload.
DB_BACKUP_EXTRA_PATHS=/project/docker-compose.yml,/project/docker-compose.ops-reporting.yml,/project/docker-compose.ops-reporting.deploy.yml,/project/.env,/project/.env.ops-reporting,/project/.env.example,/project/k8s,/project/app/xray/.env,/project/app/xray/runtime,/project/scripts
# Read-only SSH collection of the actual files deployed on both data planes.
# CLAUDE.md defines the shared root key under /root/ssh-keys; Compose mounts it
# at /run/secrets/fleet_ssh_key and the collector makes a private 0600 copy.
DB_BACKUP_SSH_COLLECTION_ENABLED=1
# Keep 0 so a node outage does not suppress the control-plane backup. Set 1
# only when a backup must fail unless both remote nodes are collected.
DB_BACKUP_SSH_COLLECTION_REQUIRED=0
DB_BACKUP_SSH_KEY_PATH=/run/secrets/fleet_ssh_key
DB_BACKUP_SSH_OPTIONS=
DB_BACKUP_SSH_TIMEOUT_SECONDS=20
DB_BACKUP_SSH_MAX_FILE_BYTES=5242880
DB_BACKUP_DATAPLANE_SSH_TARGET=root@64.186.224.96
DB_BACKUP_DATAPLANE_SSH_PORT=22
DB_BACKUP_DATAPLANE_KNOWN_HOSTS=/root/.ssh/known_hosts
# Normal data-plane host path (the running container sees this as /etc/xray/config.json).
DB_BACKUP_DATAPLANE_REMOTE_PATHS=/root/xray-routing-panel/app/xray/runtime/config.json,/root/xray-routing-panel/app/xray/.env
# nat.qq.pw:27160 is the AI NAT SSH endpoint used by this deployment.
DB_BACKUP_AI_NODE_SSH_TARGET=root@nat.qq.pw
DB_BACKUP_AI_NODE_SSH_PORT=27160
DB_BACKUP_AI_NODE_KNOWN_HOSTS=/root/.ssh/known_hosts_ai
DB_BACKUP_AI_NODE_REMOTE_PATHS=/etc/xray/config.json,/etc/xray/.env
