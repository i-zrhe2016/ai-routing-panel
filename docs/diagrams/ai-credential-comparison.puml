@startuml
!include style.iuml
title AI 隧道参数安全比对
left to right direction
file "普通数据面 outbound 字段" as normal
file "AI inbound 对应字段" as ai
component "SHA-256" as hash1
component "SHA-256" as hash2
component "本地摘要比较\n只输出 match=true/false" as compare
normal --> hash1
ai --> hash2
hash1 --> compare
hash2 --> compare

@enduml
