@startuml
!theme plain
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title AI Domain Routing, Manual Selection and Fallback

actor "Proxy Client" as client
actor "Administrator" as admin
participant "Panel API" as panel
database "app_state" as state
participant "Normal Data Plane Xray" as normal
participant "Dynamic Routing Rules" as rules
participant "AI Upstream Selector" as selector
participant "Primary AI\nnat.qq.pw:27166" as primary
participant "Backup AI\nredacted-ip-004:27166" as backup
participant "AI freedom egress" as egress
participant "Normal freedom egress" as fallback

opt administrator changes AI mode
  admin -> panel : POST /api/ai-routing/switch\nprimary | backup | auto | forced_fallback
  panel -> state : persist manual mode
  panel -> selector : run manager once
end

client -> normal : VLESS + REALITY connection
normal -> rules : classify destination
rules -> selector : read current mode and probe candidates

alt AI domain and primary selected/reachable
  selector --> rules : write ai_proxy -> primary
  rules --> normal : use ai_proxy outbound
  normal -> primary : VLESS + REALITY relay
  primary -> egress : direct outbound request
  egress --> primary : response
  primary --> normal : relayed response
else AI domain and backup selected/reachable
  selector --> rules : write ai_proxy -> backup
  rules --> normal : use ai_proxy outbound
  normal -> backup : VLESS + REALITY relay
  backup -> egress : direct outbound request
  egress --> backup : response
  backup --> normal : relayed response
else non-AI destination
  rules --> normal : use normal freedom outbound
  normal -> fallback : direct outbound request
  fallback --> normal : response
else forced fallback or selected AI unreachable
  selector --> rules : remove dynamic AI route
  rules --> normal : use local freedom fallback
  normal -> fallback : local freedom fallback
  fallback --> normal : response
end

normal --> client : proxy response

note over selector,rules
  Automatic mode probes both candidates and chooses the first reachable one.
  Manual primary/backup keeps the selected index; an unreachable fixed target
  disables dynamic routing and reports manual_target_unreachable.
end note

note over normal,backup
  Tunnel credentials are independent from normal data-plane credentials
  and are intentionally omitted from this diagram.
end note

@enduml
