!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Noto Sans CJK SC
skinparam defaultFontSize 14
skinparam defaultFontColor #24383B
skinparam defaultTextAlignment center
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundcorner 8
skinparam Padding 8
skinparam Nodesep 24
skinparam Ranksep 28
skinparam TitleFontName Noto Sans CJK SC
skinparam TitleFontSize 18
skinparam TitleFontStyle bold
skinparam TitleFontColor #174B50
skinparam ArrowColor #426C70
skinparam ArrowThickness 1.4
skinparam ArrowFontColor #36575B
skinparam componentBorderColor #52777A
skinparam componentBackgroundColor #F3F8F6
skinparam ActivityBackgroundColor #F3F8F6
skinparam ActivityBorderColor #52777A
skinparam ActivityFontColor #24383B
skinparam ActivityDiamondFontColor #24383B
skinparam NoteBackgroundColor #FFF7D6
skinparam NoteBorderColor #D2AD4A
skinparam NoteFontColor #594C26
skinparam NoteTextAlignment left
skinparam ParticipantPadding 10
skinparam SequenceLifeLineBorderColor #A9C0BE
skinparam SequenceArrowThickness 1.4
skinparam SequenceGroupBodyBackgroundColor #F5F8F7
skinparam SequenceGroupBorderThickness 1
