@startuml
!theme plain
left to right direction
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #334155
skinparam ArrowThickness 1.2
skinparam defaultFontName Arial
skinparam defaultTextAlignment center

title Xray Routing Panel - Production Architecture

actor "Proxy Client" as client
cloud "Public DNS\n(Cloudflare)" as dns #E0F2FE

node "Control Plane" as control #EFF6FF {
  component "Routing Panel\nFlask + Vue" as panel #DBEAFE
  database "panel.db\nconfiguration and state" as paneldb #E5E7EB
  component "AI Routing Controller\nmanual mode + scheduled probe" as aiController #CFFAFE
  component "Optional Backup Xray\nrelay or direct" as backup #FEF3C7
  component "Prometheus" as prometheus #FEE2E2
  component "Grafana" as grafana #F3E8FF
  component "Control Node Exporter + cAdvisor" as controlMetrics #F3F4F6
  component "Daily Reporter\nrules-only shadow mode" as reporter #DCFCE7
  database "Report audit and files" as reports #E5E7EB
  component "AI exporter SSH tunnel\nloopback only" as tunnel #E0E7FF
}

node "Normal Data Plane\nTailscale redacted-ip-003" as normal #ECFDF5 {
  component "Xray\nVLESS + REALITY" as normalXray #D1FAE5
  component "Dynamic routing fragment\nai_proxy" as dynamicRoute #CCFBF1
  component "node-exporter + cAdvisor" as normalMetrics #F3F4F6
}

node "AI Upstream Pool" as aiPool #FFF7ED {
  component "Primary AI\nnat.qq.pw:27166" as primaryAi #FED7AA
  component "Backup AI\nlocal Docker xray-ai-node\nredacted-ip-004:27166" as backupAi #FED7AA
  component "Independent Xray\nfreedom egress" as aiEgress #FFEDD5
  component "Local AI Xray metrics\nredacted-ip-007:31097" as localAiMetrics #F3F4F6
  component "node-exporter + cAdvisor\nwhen remotely deployed" as aiMetrics #F3F4F6
}

cloud "Internet" as internet #F3F4F6
cloud "Tailscale tailnet\nSSH :22" as tailnet #E0E7FF

client --> dns : resolve proxy entry
dns --> normalXray : primary traffic
normalXray --> internet : non-AI traffic
normalXray --> primaryAi : selected AI upstream
normalXray --> backupAi : selected AI upstream
primaryAi --> aiEgress
backupAi --> aiEgress
aiEgress --> internet
normalXray ..> internet : local fallback when AI unavailable

panel --> paneldb
panel --> aiController : dashboard + POST /api/ai-routing/switch
aiController --> paneldb : persist auto / primary / backup / forced_fallback
aiController ..> normalXray : probe / render / restart
aiController ..> primaryAi : probe candidate
aiController ..> backupAi : local Docker status / restart
panel ..> normalXray : status / controlled management
panel ..> dns : failover updates
panel ..> backup : render and manage
backup ..> backupAi : relay when enabled
backup ..> internet : direct fallback
panel --> localAiMetrics : loopback /debug/vars

aiController --> dynamicRoute : generate selected route
normalXray --> aiController : access.log / route status
dynamicRoute --> normalXray : merged into config.json
control ..> tailnet : SSH manage normal data plane
tailnet ..> normal : strict host-key + public-key SSH

panel --> prometheus : authenticated /metrics
controlMetrics --> prometheus : host + container metrics
normalMetrics --> prometheus : metrics
aiMetrics --> tunnel : exporter HTTP
tunnel --> prometheus : loopback forwards
prometheus --> grafana
prometheus --> reporter
reporter --> reports

note bottom of control
  User proxy traffic remains on the data plane
  and does not require the control plane to stay online.
end note

@enduml
