@startuml
!include ../../diagrams/style.iuml
left to right direction

title 旧日志采集器的替代链路

node "Data Planes" as nodes #ECFDF5 {
  component "node-exporter" as nodeExporter
  component "cAdvisor" as cadvisor
}

node "Control Plane" as control #EFF6FF {
  component "Prometheus" as prometheus #FEE2E2
  component "Attribution Sampler\nHMAC counters only" as sampler #FAD7A0
  database "SQLite\noptional redacted counters" as snapshots #E5E7EB
  component "Daily Reporter\ndeterministic rules + Codex" as reporter #DCFCE7
  folder "JSON / Markdown reports" as reports #FEF3C7
}

nodeExporter --> prometheus : metrics only
cadvisor --> prometheus : metrics only
nodes ..> sampler : optional fixed stats reads
prometheus --> reporter : HTTP API
sampler --> snapshots : HMAC snapshots
snapshots --> reporter : optional counter deltas
reporter --> reports

package "Retired reference" #FFF1F0 {
  component "SSH raw-log collector" as oldCollector #FECACA
  note bottom of oldCollector
    Removed from production.
    No path connects it to the active metrics/reporting flow.
  end note
}

note right of sampler
  Fixed stats reads only.
  No access logs, Docker logs, or systemd logs.
end note

note bottom of nodes
  Exporters are scraped over the restricted Tailscale management network.
  The reporter itself has no SSH access.
end note

@enduml
