@startuml
!include ../../diagrams/style.iuml
left to right direction

title Exporter 网络隔离

actor "Untrusted Internet Client" as publicClient

node "Control Plane" as control #EFF6FF {
  component "Prometheus\nloopback API only" as prometheus #FEE2E2
}

node "Normal Data Plane" as normal #ECFDF5 {
  component "Host Firewall\nEXPORTER_BIND_ADDRESS\nCompose default: 0.0.0.0" as normalFirewall #FEF3C7
  component "node-exporter" as normalNode #F8FAFC
  component "cAdvisor" as normalCadvisor #F8FAFC
}

node "Taiwan AI Data Plane" as ai #FFF7ED {
  component "Tailscale + Host Firewall\nEXPORTER_BIND_ADDRESS\nCompose default: 0.0.0.0" as aiFirewall #FEF3C7
  component "node-exporter" as aiNode #F8FAFC
  component "cAdvisor" as aiCadvisor #F8FAFC
}

publicClient -[#DC2626,dashed]-> normalFirewall : denied
publicClient -[#DC2626,dashed]-> aiFirewall : denied
prometheus --> normalFirewall : restricted scrape
normalFirewall --> normalNode
normalFirewall --> normalCadvisor
prometheus --> aiFirewall : restricted Tailscale scrape
aiFirewall --> aiNode : :9100
aiFirewall --> aiCadvisor : :18081

legend right
  |= Color |= Meaning |
  |<#DCFCE7> | Data plane boundary |
  |<#EFF6FF> | Control plane boundary |
  |<#FEF3C7> | Network enforcement |
  |<#FEE2E2> | Metrics storage/query |
endlegend

note bottom of aiFirewall
  Check the effective host port binding.
  Firewall and cloud security group must allow only scrape sources.
end note

@enduml
