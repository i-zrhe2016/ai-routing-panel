{
  "name": "xray-routing-panel-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Build/test toolchain for the admin + portal Vue SPAs (emits app/static/{admin,portal}/).",
  "scripts": {
    "build": "vite build && vite build -c vite.portal.config.js",
    "build:admin": "vite build",
    "build:portal": "vite build -c vite.portal.config.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "naive-ui": "^2.44.1",
    "vue-router": "^4.6.4"
  }
}
