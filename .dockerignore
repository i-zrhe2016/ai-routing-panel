# Built SPA bundles are produced by the frontend-builder stage, not copied from
# the build context.
app/static/.DS_Store
app/static/admin
app/static/portal
app/static/landing

# Keep local frontend dependencies out of both application and ops builds.
frontend/node_modules
node_modules
