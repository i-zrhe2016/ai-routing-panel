# One of: control_plane, normal_data_plane, ai_data_plane
FLUENT_BIT_NODE_ROLE=control_plane
FLUENT_BIT_HOST=control-plane

# Tailscale MagicDNS name or stable tailnet address of the Loki host.
FLUENT_BIT_LOKI_HOST=loki.tailnet.example
FLUENT_BIT_LOKI_PORT=3100

# Host directory containing Xray error.log.
FLUENT_BIT_XRAY_LOG_DIR=/root/ai-routing-panel/app/xray/logs

# Filesystem backlog cap for this node.
FLUENT_BIT_STORAGE_LIMIT=2G

# Override only when the host uses different unit names.
FLUENT_BIT_SYSTEMD_UNIT_1=docker.service
FLUENT_BIT_SYSTEMD_UNIT_2=containerd.service
FLUENT_BIT_SYSTEMD_UNIT_3=tailscaled.service
FLUENT_BIT_SYSTEMD_UNIT_4=xray.service
