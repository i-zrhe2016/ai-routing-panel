{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Xray Observability (embed)",
  "uid": "xray-observability",
  "tags": [
    "xray",
    "panel",
    "embed"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "基础设施｜主机资源（node_exporter）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）"
        }
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "基础设施｜CPU 忙碌率（%）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "主机={{host}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "基础设施｜内存使用率（%）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "主机={{host}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "基础设施｜网络流量速率（字节/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_network_receive_bytes_total{device=~\"e.*\"}[5m])",
          "legendFormat": "主机={{host}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(node_network_transmit_bytes_total{device=~\"e.*\"}[5m])",
          "legendFormat": "主机={{host}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "基础设施｜根文件系统使用率（%）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/host\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/host\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "主机={{host}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "基础设施｜1 分钟负载（无量纲）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "node_load1",
          "legendFormat": "主机={{host}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "基础设施｜Swap 使用率（%）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_SwapFree_bytes / clamp_min(node_memory_SwapTotal_bytes, 1))",
          "legendFormat": "主机={{host}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Traffic (per port)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "普通数据面｜端口流量速率（字节/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(xray_panel_port_traffic_bytes_total[5m])",
          "legendFormat": "主机={{host}}｜端口={{port}}｜方向={{direction}}｜备注={{note}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "普通数据面｜端口连接建立速率（连接/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(xray_panel_port_connections_total[5m])",
          "legendFormat": "主机={{host}}｜端口={{port}}｜方向={{direction}}｜备注={{note}}"
        }
      ]
    },
    {
      "id": 120,
      "type": "row",
      "title": "AI 数据面｜域名与端口流量（最近 10 分钟）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）"
        }
      }
    },
    {
      "id": 121,
      "type": "timeseries",
      "title": "AI 数据面｜高流量域名/端口请求速率（次/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(20, xray_panel_ai_destination_requests_per_second)",
          "legendFormat": "域名={{domain}}｜端口={{port}}｜协议={{network}}"
        }
      ]
    },
    {
      "id": 122,
      "type": "table",
      "title": "AI 数据面｜最近窗口请求量 Top 20",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(20, xray_panel_ai_destination_requests)",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 123,
      "type": "timeseries",
      "title": "AI 数据面｜总流量速率（字节/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "不可用（无指标或无采样）"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(xray_panel_ai_node_traffic_bytes_total[5m])",
          "legendFormat": "入站｜方向={{direction}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(xray_panel_ai_node_egress_bytes_total[5m])",
          "legendFormat": "直出｜方向={{direction}}"
        }
      ]
    },
    {
      "id": 110,
      "type": "row",
      "title": "容器资源｜cAdvisor（控制面、普通数据面、AI 数据面）",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "id": 111,
      "type": "timeseries",
      "title": "容器｜CPU 使用率（%）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）",
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (host,node_role,name) (rate(container_cpu_usage_seconds_total{name!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "主机={{host}}｜节点角色={{node_role}}｜容器={{name}}"
        }
      ]
    },
    {
      "id": 112,
      "type": "timeseries",
      "title": "容器｜内存工作集（字节）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）",
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host,node_role,name) (container_memory_working_set_bytes{name!=\"\",image!=\"\"})",
          "legendFormat": "主机={{host}}｜节点角色={{node_role}}｜容器={{name}}"
        }
      ]
    },
    {
      "id": 113,
      "type": "timeseries",
      "title": "容器｜网络接收速率（字节/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）",
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host,node_role,name) (rate(container_network_receive_bytes_total{name!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "主机={{host}}｜节点角色={{node_role}}｜容器={{name}}"
        }
      ]
    },
    {
      "id": 114,
      "type": "timeseries",
      "title": "容器｜网络发送速率（字节/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）",
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host,node_role,name) (rate(container_network_transmit_bytes_total{name!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "主机={{host}}｜节点角色={{node_role}}｜容器={{name}}"
        }
      ]
    },
    {
      "id": 115,
      "type": "timeseries",
      "title": "容器｜文件系统读写速率（字节/秒）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）",
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host,node_role,name) (rate(container_fs_reads_bytes_total{name!=\"\",image!=\"\"}[5m])) + sum by (host,node_role,name) (rate(container_fs_writes_bytes_total{name!=\"\",image!=\"\"}[5m]))",
          "legendFormat": "主机={{host}}｜节点角色={{node_role}}｜容器={{name}}"
        }
      ]
    },
    {
      "id": 116,
      "type": "timeseries",
      "title": "容器｜启动时间（Unix 时间戳）",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "不可用（无指标或无采样）",
          "unit": "dateTimeAsIso",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host,node_role,name) (container_start_time_seconds{name!=\"\",image!=\"\"})",
          "legendFormat": "主机={{host}}｜节点角色={{node_role}}｜容器={{name}}"
        }
      ]
    }
  ]
}
